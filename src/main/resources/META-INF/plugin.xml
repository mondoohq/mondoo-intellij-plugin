<idea-plugin>
  <id>com.mondoo.security</id>
  <name>Mondoo</name>
  <vendor email="hello@mondoo.com" url="https://mondoo.com">Mondoo, Inc.</vendor>


  <!-- The ONLY hard dependency. Nothing product-specific (no
       com.intellij.modules.java / .python / .go), so the Marketplace marks this
       plugin compatible with all IntelliJ-based products. -->
  <depends>com.intellij.modules.platform</depends>

  <!-- LSP-backed live scanning is optional: it loads only where
       com.intellij.modules.lsp is present. Everything else in the plugin works
       without it.

       This uses the legacy optional-depends form rather than a v2 <content>
       module on purpose. com.intellij.modules.lsp is a plugin-alias module in
       the "jetbrains" namespace with internal visibility, and a v2 content
       module cannot depend on it — both GoLand and Android Studio log
       "module com.intellij.modules.lsp (namespace=jetbrains) is not resolved"
       and silently exclude ours. See docs/adr/0001. -->
  <depends optional="true" config-file="mondoo-lsp.xml">com.intellij.modules.lsp</depends>

  <resource-bundle>messages.MondooBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="com.mondoo.intellij.settings.MondooSettings"/>

    <applicationConfigurable
        id="com.mondoo.intellij.settings"
        groupId="tools"
        bundle="messages.MondooBundle" key="settings.display.name"
        instance="com.mondoo.intellij.settings.MondooConfigurable"/>

    <!-- In-editor bar when a scannable file is open but no scanner is available.
         A banner rather than a balloon: the condition persists until acted on, and
         a dismissed balloon leaves the user with no findings and no explanation. -->
    <editorNotificationProvider
        implementation="com.mondoo.intellij.ui.XgrepSetupBannerProvider"/>

    <notificationGroup id="Mondoo" displayType="BALLOON"
                       bundle="messages.MondooBundle" key="notification.group.mondoo"/>

    <projectService serviceImplementation="com.mondoo.intellij.findings.XgrepFindingsStore"/>
    <projectService serviceImplementation="com.mondoo.intellij.lsp.XgrepScanCoordinator"/>
    <projectService serviceImplementation="com.mondoo.intellij.lsp.XgrepScanNotifier"/>
    <projectService serviceImplementation="com.mondoo.intellij.search.XgrepSearchService"/>
    <projectService serviceImplementation="com.mondoo.intellij.bom.BomService"/>
    <projectService serviceImplementation="com.mondoo.intellij.policy.PolicyLintService"/>
    <projectService serviceImplementation="com.mondoo.intellij.policy.PolicyIndexService"/>
    <projectService serviceImplementation="com.mondoo.intellij.target.TargetStore"/>
    <projectService serviceImplementation="com.mondoo.intellij.target.CnspecRunService"/>
    <projectService serviceImplementation="com.mondoo.intellij.deps.DependencyReachabilityService"/>

    <toolWindow id="Mondoo"
                anchor="bottom"
                canCloseContents="false"
                icon="/icons/mondoo.svg"
                factoryClass="com.mondoo.intellij.findings.XgrepFindingsToolWindowFactory"/>

    <statusBarWidgetFactory id="mondoo.xgrep"
                            order="before positionWidget"
                            implementation="com.mondoo.intellij.findings.XgrepStatusBarWidgetFactory"/>

    <!-- Resolves the scanner in the background on project open. Never downloads
         unprompted; see XgrepStartupActivity. -->
    <backgroundPostStartupActivity
        implementation="com.mondoo.intellij.binary.XgrepStartupActivity"/>
    <backgroundPostStartupActivity
        implementation="com.mondoo.intellij.actions.MondooOnboardingActivity"/>

    <!-- Verifies that declared actions and services actually resolve. Inert unless
         -Dmondoo.selfcheck=true; see MondooSelfCheck. -->
    <backgroundPostStartupActivity
        implementation="com.mondoo.intellij.MondooSelfCheck"/>
  </extensions>

  <actions>
    <group id="Mondoo.CodeSecurity" popup="true"
           text="Mondoo Code Security" description="Mondoo code security actions"
           icon="/icons/mondoo.svg">
      <action id="Mondoo.Xgrep.ScanWorkspace"
              class="com.mondoo.intellij.actions.ScanWorkspaceAction"
              text="Scan Workspace"
              description="Check every file in the workspace"/>
      <action id="Mondoo.Xgrep.ScanChanged"
              class="com.mondoo.intellij.actions.ScanChangedFilesAction"
              text="Scan Changed Files (Fast)"
              description="Check only files that are new or modified according to git"/>
      <action id="Mondoo.Xgrep.ScanSince"
              class="com.mondoo.intellij.actions.ScanChangesSinceAction"
              text="Scan Changes Since..."
              description="Check only what changed since a git ref you pick"/>
      <action id="Mondoo.Xgrep.ClearFindings"
              class="com.mondoo.intellij.actions.ClearFindingsAction"
              text="Clear Findings"
              description="Empty the findings view"/>
      <separator/>
      <action id="Mondoo.Deps.Analyze"
              class="com.mondoo.intellij.actions.AnalyzeDependenciesAction"
              text="Analyze Dependencies"
              description="Show which dependency packages your code actually imports"/>
      <action id="Mondoo.Bom.Generate"
              class="com.mondoo.intellij.actions.GenerateBomAction"
              text="Generate Bill of Materials..."
              description="Inventory dependencies, cryptography or AI components"/>
      <separator/>
      <action id="Mondoo.Xgrep.SearchCode"
              class="com.mondoo.intellij.actions.SearchCodeAction"
              text="Search Code..."
              description="Structural code search"/>
      <action id="Mondoo.Xgrep.ReplaceCode"
              class="com.mondoo.intellij.actions.ReplaceCodeAction"
              text="Replace Code..."
              description="Structural search and replace, previewed before anything is written"/>
      <action id="Mondoo.Xgrep.ExportSearchRule"
              class="com.mondoo.intellij.actions.ExportSearchRuleAction"
              text="Export Search as Rule"
              description="Turn a structural pattern into a reusable xgrep rule"/>
      <separator/>
      <!-- Policy authoring. These stay hidden unless the focused file is a policy
           bundle, so they cost nothing in a project that has none. -->
      <action id="Mondoo.Policy.New"
              class="com.mondoo.intellij.policy.NewPolicyFromTemplateAction"
              text="New Policy from Template..."
              description="Scaffold a policy bundle with cnspec and open it"/>
      <action id="Mondoo.Policy.Lint"
              class="com.mondoo.intellij.policy.LintPolicyAction"
              text="Lint Policy Bundle"
              description="Check policy hygiene: tags, asset filters, unused queries"/>
      <action id="Mondoo.Policy.Format"
              class="com.mondoo.intellij.policy.FormatPolicyAction"
              text="Format Policy Bundle"
              description="Apply cnspec's own formatting to this bundle"/>
      <action id="Mondoo.Policy.FormatSorted"
              class="com.mondoo.intellij.policy.FormatPolicySortedAction"
              text="Format and Sort Policy Bundle"
              description="Format this bundle and sort its queries"/>
      <separator/>
      <action id="Mondoo.Target.Scan"
              class="com.mondoo.intellij.target.ScanTargetAction"
              text="Scan Target..."
              description="Run policies against this machine or a configured target"/>
      <action id="Mondoo.Target.RunQuery"
              class="com.mondoo.intellij.target.RunQueryAction"
              text="Run MQL Query..."
              description="Run a single MQL query against a target"/>
      <action id="Mondoo.Target.Manage"
              class="com.mondoo.intellij.target.ManageTargetsAction"
              text="Manage Targets..."
              description="Add or remove the targets cnspec can scan"/>
      <separator/>
      <action id="Mondoo.Xgrep.Setup"
              class="com.mondoo.intellij.actions.SetupScannerAction"
              text="Set Up Scanner"
              description="Find or download the xgrep security scanner"/>
      <action id="Mondoo.Xgrep.InstallSkills"
              class="com.mondoo.intellij.actions.InstallAiSkillsAction"
              text="Install AI Skills..."
              description="Install xgrep's skills for AI coding agents"/>
      <action id="Mondoo.Xgrep.ConfigureMcp"
              class="com.mondoo.intellij.actions.ConfigureMcpAction"
              text="Configure MCP Server..."
              description="Expose xgrep to AI agents over MCP"/>
      <separator/>
      <action id="Mondoo.Xgrep.OpenDemo"
              class="com.mondoo.intellij.actions.OpenDemoFileAction"
              text="Open Demo File"
              description="Write a deliberately vulnerable file and open it"/>
      <action id="Mondoo.Xgrep.Documentation"
              class="com.mondoo.intellij.actions.OpenDocumentationAction"
              text="Documentation"
              description="Open the Mondoo documentation"/>
      <separator/>
      <action id="Mondoo.Xgrep.ShowPath"
              class="com.mondoo.intellij.actions.ShowXgrepPathAction"
              text="Show Tool Paths"
              description="Show which xgrep, cnspec and mqlr binaries this plugin resolves"/>
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </group>
  </actions>
</idea-plugin>
