<!--
  Optional dependency descriptor: LSP-backed live scanning.

  Loaded only when com.intellij.modules.lsp is present (see the <depends
  optional> in plugin.xml).

  Registered under `platform.lsp.serverSupportProvider`, NOT
  `platform.lsp.integrationProvider`. Both exist at the 261.26222 floor, but
  GoLand 2026.2 EAP (GO-262.6228.35) ships only serverSupportProvider — and
  untilBuild is open, so we must survive builds that lack the newer EP.
  LspServerSupportProvider extends LspIntegrationProvider, so nothing is lost.
-->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <!-- Announces in idea.log that this optional module actually loaded.
         <depends optional> is otherwise completely silent. Application-level so
         it fires even with no project open. -->
    <applicationInitializedListener
        implementation="com.mondoo.intellij.lsp.XgrepLspModuleProbe"/>
    <backgroundPostStartupActivity
        implementation="com.mondoo.intellij.lsp.XgrepLspProjectProbe"/>

    <!-- Suppression is ours, not the server's: xgrep publishes fixes for rules
         that have one, but nogrep comments are built client-side. No `language`
         attribute — naming a language here would fail to resolve in IDEs that
         lack that language plugin, which is most of them. -->
    <intentionAction>
      <language/>
      <className>com.mondoo.intellij.fix.SuppressFindingIntention</className>
      <category>Mondoo Code Security</category>
    </intentionAction>
    <intentionAction>
      <language/>
      <className>com.mondoo.intellij.fix.SuppressFindingWithReasonIntention</className>
      <category>Mondoo Code Security</category>
    </intentionAction>

    <platform.lsp.serverSupportProvider
        implementation="com.mondoo.intellij.lsp.XgrepLspServerSupportProvider"/>
  </extensions>
</idea-plugin>
